extends layout

block content
    - const esPlanta = user?.tipo === 'PLANTA'

    p Selecciona la sección que desea administrar
    div.actions
        if esPlanta
            a.btn(href='/actores') Actores
            a.btn(href='/productos') Productos
            a.btn(href='/insumos') Insumos
        a.btn(href='/pedidos') Pedidos

    if esPlanta
        br
        p Además, puede ver distintos reportes accediendo a
        div.actions
            a.btn(href='/reportes') Reportes
