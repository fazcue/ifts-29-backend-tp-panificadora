extends ../layout
include ../mixins/cabecera
include ../mixins/reporteError

block content
    - const esPlanta = user?.tipo === 'PLANTA'

    //- Cabecera
    +cabecera('Nuevo pedido')

    //- Reporte de error
    +reporteError(error)

    //- Formulario de alta
    form.panel(action='/pedidos/nuevo' method='POST')
        
        div.field
            label(for='fecha_entrega_esperada') Fecha de entrega esperada
            input#fecha_entrega_esperada(type='date' name='fecha_entrega_esperada' value=pedido && pedido.fecha_entrega_esperada required)
        
        if esPlanta
            div.field
                label(for='id_actor') Actor
                select#id_actor(name='id_actor' required)
                    option(value='') Seleccionar...
                    each actor in actores
                        option(value=actor.id selected=pedido && String(pedido.actor)===String(actor.id))= `${actor.nombre} - ${actor.tipo}`
        else
            input(type='hidden' name='id_actor' value=user.id)
        
        div.field
            label Productos
            if productos && productos.length > 0
                ul.list
                    each producto, index in productos
                        li.item(data-producto-row)
                            div.info
                                h3= producto.nombre
                                p= `Precio: $${producto.precio}`
                            div.actions
                                input(
                                    type='hidden'
                                    name=`productos[${index}][id_producto]`
                                    value=producto.id
                                )
                                label(for=`producto_${producto.id}`) Cantidad
                                input(
                                    id=`producto_${producto.id}`
                                    type='number'
                                    name=`productos[${index}][cantidad]`
                                    min='0'
                                    step='1'
                                    value=producto.cantidad_pedida || ''
                                )
            else 
                p.empty Sin productos activos registrados
        
        div.actions
            button.btn(type='submit') Guardar
            a.btn.btn-secondary(href='/pedidos') Cancelar
