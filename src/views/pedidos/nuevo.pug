extends ../layout
include ../mixins/cabecera
include ../mixins/reporteError

block content
    //- Cabecera
    +cabecera('Nuevo pedido')

    //- Reporte de error
    +reporteError(error)

    //- Formulario de alta
    form.panel(action='/pedidos/nuevo' method='POST')
        
        div.field
            label(for='fecha_entrega_esperada') Fecha de entrega esperada
            input#fecha_entrega_esperada(type='date' name='fecha_entrega_esperada' value=pedido && pedido.fecha_entrega_esperada required)
        
        div.field
            label(for='id_actor') Actor
            select#id_actor(name='id_actor' required)
                option(value='') Seleccionar...
                each actor in actores
                    option(value=actor.id selected=pedido && String(pedido.actor)===String(actor.id))= `${actor.nombre} - ${actor.tipo}`
        
        div.actions
            button.btn(type='submit') Guardar
            a.btn.btn-secondary(href='/pedidos') Cancelar
