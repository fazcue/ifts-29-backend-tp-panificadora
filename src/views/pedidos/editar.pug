extends ../layout
include ../mixins/cabecera
include ../mixins/reporteError

block content
    - const esPlanta = user?.tipo === 'PLANTA'

    //- Cabecera
    +cabecera('Editar pedido')

    //- Reporte de error
    +reporteError(error)

    //- Formulario de edición
    form.panel(action=`/pedidos/editar/${pedido.id}` method='POST')
        
        div.field
            label(for='fecha_entrega_esperada') Fecha de entrega esperada
            input#fecha_entrega_esperada(type='date' name='fecha_entrega_esperada' value=pedido.fecha_entrega_esperada required)
        
        if pedido.fecha_entrega_real
            div.field
                label Fecha de entrega real
                p= pedido.fecha_entrega_real
        
        if esPlanta
            div.field
                label(for='estado') Estado
                select#estado(name='estado' required)
                    each estado in estados
                        option(value=estado selected=pedido.estado===estado)= estado
        else
            input(type='hidden' name='estado' value=pedido.estado)
        
        if esPlanta
            div.field
                label(for='id_actor') Actor
                select#id_actor(name='id_actor' required)
                    each actor in actores
                        option(value=actor.id selected=pedido.actor && String(pedido.actor)===String(actor.id))= `${actor.nombre} - ${actor.tipo}`
        else
            input(type='hidden' name='id_actor' value=pedido.actor)
        
        div.field
            label Productos
            if productos && productos.length > 0
                ul.list
                    each producto, index in productos
                        li.item(data-producto-row)
                            div.info
                                h3= producto.nombre
                                p= `Precio: $${producto.precio}`
                            div.actions
                                input(
                                    type='hidden'
                                    name=`productos[${index}][id_producto]`
                                    value=producto.id
                                )
                                label(for=`producto_${producto.id}`) Cantidad
                                input(
                                    id=`producto_${producto.id}`
                                    type='number'
                                    name=`productos[${index}][cantidad]`
                                    min='0'
                                    step='1'
                                    value=producto.cantidad_pedida || ''
                                )
        
        div.actions
            button.btn(type='submit') Guardar
            a.btn.btn-secondary(href='/pedidos') Cancelar
