extends ../layout
include ../mixins/cabecera

block content
    //- Cabecera con enlace
    +cabecera('Pedidos')
        a.btn(href='/pedidos/nuevo') Agregar

    //- Listado pedidos
    if pedidos.length > 0
        ul.list
            each pedido in pedidos
                li.item
                    div.info
                        h3= `Pedido #${pedido.id}`
                        p= pedido.actor ? `${pedido.actor.nombre} - ${pedido.actor.tipo}` : 'Actor no encontrado'
                        p= `Entrega esperada: ${pedido.fecha_entrega_esperada}`
                        if pedido.fecha_entrega_real
                            p= `Entrega real: ${pedido.fecha_entrega_real}`

                    span.badge(class=pedido.estado === 'ENTREGADO' ? 'badge-on' : 'badge-off')= pedido.estado

                    div.actions
                        a.btn.btn-secondary(href=`/pedidos/editar/${pedido.id}`) Editar
                        form(action=`/pedidos/eliminar/${pedido.id}` method='POST')
                            button.btn(type='submit') Eliminar
    else
        p.empty Sin pedidos registrados
