extends ../layout
include ../mixins/cabecera

block content
    - const esPlanta = user?.tipo === 'PLANTA'
    - const activo = user?.activo

    //- Cabecera con enlace
    +cabecera('Pedidos')
        if esPlanta || activo
            a.btn(href='/pedidos/nuevo') Nuevo

    //- Listado pedidos
    div#lista-pedidos
        include lista-pedidos.pug
