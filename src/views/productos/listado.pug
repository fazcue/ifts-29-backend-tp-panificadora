extends ../layout
include ../mixins/cabecera

block content
    //- Cabecera con enlace
    +cabecera('Productos')
        a.btn(href='/productos/nuevo') Nuevo

    //- Listado productos
    if productos.length > 0
        ul.list
            each producto in productos
                li.item
                    div.info
                        h3= producto.nombre
                        p= `Precio: $${producto.precio}`

                    if producto.activo
                        span.badge.badge-on ACTIVO
                    else
                        span.badge.badge-off NO ACTIVO

                    div.actions
                        a.btn.btn-secondary(href=`/productos/editar/${producto.id}`) Editar
                        form(action=`/productos/cambiar-estado/${producto.id}` method='POST')
                            if producto.activo
                                button.btn(type='submit') Desactivar
                            else
                                button.btn(type='submit') Activar
                        form(action=`/productos/eliminar/${producto.id}` method='POST')
                            button.btn(type='submit') Eliminar
    else
        p.empty Sin productos registrados
