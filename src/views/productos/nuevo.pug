extends ../layout
include ../mixins/cabecera
include ../mixins/reporteError

block content
    //- Cabecera
    +cabecera('Nuevo producto')

    //- Reporte de error
    +reporteError(mensaje)

    //- Formulario de alta
    form.panel(action='/productos/nuevo' method='POST')
        
        div.field
            label(for='nombre') Nombre
            input#nombre(type='text' name='nombre' value=producto && producto.nombre required)
        
        div.field
            label(for='precio') Precio
            input#precio(type='number' name='precio' min='0.01' step='0.01' value=producto && producto.precio required)
        
        div.actions
            button.btn(type='submit') Guardar
            a.btn.btn-secondary(href='/productos') Cancelar
