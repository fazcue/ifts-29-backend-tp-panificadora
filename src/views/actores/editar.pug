extends ../layout
include ../mixins/cabecera
include ../mixins/reporteError

block content
    //- Cabecera
    +cabecera('Editar actor')

    //- Reporte de error
    +reporteError(error)

    //- Formulario de edición
    form.panel(action=`/actores/editar/${actor.id}` method='POST')

        div.field
            label(for='nombre') Nombre
            input#nombre(type='text' name='nombre' value=actor.nombre required)
        
        div.field
            label(for='email') Email
            input#email(type='email' name='email' value=actor.email required)
        
        div.field
            label(for='tipo') Tipo
            select#tipo(name='tipo' required)
                each tipo in tipos
                    option(value=tipo selected=actor.tipo===tipo)= tipo
        
        div.actions
            button.btn(type='submit') Guardar
            a.btn.btn-secondary(href='/actores') Cancelar
