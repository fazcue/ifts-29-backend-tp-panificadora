extends ../layout

block content
    div.page-heading
        div
            p.eyebrow Gestion
            h2 Actores
        a.btn(href='/actores/nuevo') Nuevo actor

    if actores.length > 0
        ul.actor-list
            each actor in actores
                li.actor-item
                    div.actor-info
                        h3= actor.nombre
                        p= actor.tipo
                        if actor.email
                            p= actor.email

                    if actor.activo
                        span.badge.badge-on activo
                    else
                        span.badge.badge-off no activo

                    div.actions
                        a.btn.btn-sm.btn-secondary(href=`/actores/editar/${actor.id}`) Editar
                        form.inline(action=`/actores/activar-desactivar/${actor.id}` method='POST')
                            if actor.activo
                                button.btn.btn-sm(type='submit') Desactivar
                            else
                                button.btn.btn-sm(type='submit') Activar

    else
        p.empty-state Sin actores registrados
