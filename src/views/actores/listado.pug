extends ../layout
include ../mixins/cabecera

block content
    //- Cabecera con enlace
    +cabecera('Actores')
        a.btn(href='/actores/nuevo') Agregar
    
    //- Listado actores
    if actores.length > 0
        ul.list
            each actor in actores
                li.item
                    div.info
                        h3= actor.nombre
                        p= actor.tipo
                        if actor.email
                            p= actor.email

                    if actor.activo
                        span.badge.badge-on ACTIVO
                    else
                        span.badge.badge-off NO ACTIVO

                    div.actions
                        a.btn.btn-secondary(href=`/actores/editar/${actor.id}`) Editar
                        form(action=`/actores/activar-desactivar/${actor.id}` method='POST')
                            if actor.activo
                                button.btn(type='submit') Desactivar
                            else
                                button.btn(type='submit') Activar
    else 
        p.empty Sin actores registrados
