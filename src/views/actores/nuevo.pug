extends ../layout

block content
    div.page-heading
        div
            p.eyebrow Actores
            h2 Nuevo actor

    if error
        p.alert= error

    form.form-panel(action='/actores/nuevo' method='POST')
        div.form-field
            label(for='nombre') Nombre
            input#nombre(type='text' name='nombre' value=actor && actor.nombre required)
        div.form-field
            label(for='tipo') Tipo
            select#tipo(name='tipo' required)
                option(value='') Seleccionar...
                each tipo in tipos
                    option(value=tipo selected=actor && actor.tipo===tipo)= tipo
        div.form-actions
            button.btn(type='submit') Guardar
            a.btn.btn-secondary(href='/actores') Cancelar
