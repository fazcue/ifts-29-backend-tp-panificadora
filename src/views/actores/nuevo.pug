extends ../layout
include ../mixins/cabecera
include ../mixins/reporteError

block content
    //- Cabecera
    +cabecera(titulo || 'Nuevo actor')

    //- Reporte de error
    +reporteError(error)

    //- Formulario de alta
    form.panel(action=formAction || '/actores/nuevo' method='POST')

        div.field
            label(for='nombre') Nombre
            input#nombre(type='text' name='nombre' value=actor && actor.nombre required)
        
        div.field
            label(for='email') Email
            input#email(type='email' name='email' value=actor && actor.email required)
        
        div.field
            label(for='password') Contraseña
            input#password(type='password' name='password' required)

        div.field
            label(for='tipo') Tipo
            if modoAltaPlanta
                input(type='hidden' name='tipo' value='PLANTA')
                input#tipo(type='text' value='PLANTA' disabled)
            else
                select#tipo(name='tipo' required)
                    option(value='') Seleccionar...
                    each tipo in tipos
                        if tipo !== 'PLANTA'
                            option(value=tipo selected=actor && actor.tipo===tipo)= tipo

        if modoAltaPlanta
            div.field
                label(for='clave_alta_planta') Clave de alta
                input#clave_alta_planta(type='password' name='clave_alta_planta' value=claveAltaPlanta required)
        
        div.actions
            button.btn(type='submit') Guardar
            a.btn.btn-secondary(href=cancelarHref || '/actores') Cancelar
